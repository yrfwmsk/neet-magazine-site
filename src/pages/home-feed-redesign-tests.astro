---
import { getCollection } from 'astro:content';
import ArchiveCard from '../components/ArchiveCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeIntroBanner from '../components/HomeIntroBanner.astro';
import { VOLUME_ACCENTS } from '../lib/accent-test';
import { formatDate, getDateParts, getEventDateKey, getTokyoDateKey } from '../lib/date';

const [magazines, events] = await Promise.all([getCollection('magazines'), getCollection('events')]);
const mag = magazines.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())[0];
const accent = mag ? (VOLUME_ACCENTS[mag.data.volume] ?? mag.data.accentColor ?? '#751F32') : '#751F32';
const volNum = (mag?.data.volume ?? 'vol5').replace(/^vol/i, '').padStart(2, '0');
const feature = mag?.data.featureTitle ?? '';
const guests = mag?.data.guests ?? [];
const pub = mag ? formatDate(mag.data.publishedAt) : '';
const arch = mag?.data.archiveAt ? formatDate(mag.data.archiveAt) : '';
const magHref = mag ? `/magazines/${mag.data.volume}` : '#';
const EVENT_MARK = '#1F1C1D';
const todayKey = getTokyoDateKey();
const ev =
	events
		.map((e) => ({
			dateKey: getEventDateKey(e.data.date),
			date: e.data.date,
			title: e.data.title,
			place: e.data.place,
			booth: e.data.booth,
			href: `/events/${e.id}`,
			meta: formatDate(e.data.date),
		}))
		.sort((a, b) => a.dateKey.localeCompare(b.dateKey))
		.find((i) => i.dateKey >= todayKey) ?? null;
const evParts = ev ? getDateParts(ev.date) : null;

const currentDesc =
	guests.length > 0
		? `<span class="home-feed__row"><span class="home-feed__block"><span class="home-feed__label">スペシャルゲスト</span><span class="home-feed__guests">${guests.join('　')}</span></span><span class="home-feed__dates"><span>発売日</span><span>${pub}</span><span>デジタルアーカイブ公開</span><span>${arch}</span></span></span>`
		: undefined;
const currentEventDesc = ev
	? ev.booth
		? `<span class="home-feed__row"><span class="home-feed__block"><span class="home-feed__label">場所</span><span class="home-feed__place">${ev.place}</span></span><span class="home-feed__block home-feed__block--end"><span class="home-feed__label">ブース</span><span class="home-feed__booth">【${ev.booth}】</span></span></span>`
		: `<span class="home-feed__block"><span class="home-feed__label">場所</span><span class="home-feed__place">${ev.place}</span></span>`
	: '';

const variants = [
	{
		id: 'a',
		title: 'A · 現行',
		blurb: 'いまのトップ。比較の基準。',
	},
	{
		id: 'b',
		title: 'B · マストヘッド',
		blurb: '最新号を全幅の見出し帯に。特集を新聞の大見出しのように置き、イベントは下の補助行。',
	},
	{
		id: 'c',
		title: 'C · 対称パネル',
		blurb: '左右1:1。特集 vs ブースを対になる「看板」として見せる。情報の重みを揃える。',
	},
	{
		id: 'd',
		title: 'D · ポスター＋付箋',
		blurb: '最新号を縦長ポスター、イベントを小さな付箋カード。主従をはっきり分ける。',
	},
	{
		id: 'e',
		title: 'E · スケジュール板',
		blurb: '日付マークを軸にした予定表。発売・公開・出店を同じリズムで並べる。',
	},
	{
		id: 'f',
		title: 'F · 誌面ゲラ',
		blurb: '組版原稿っぽい密なタイポ。罫線と等幅メタで、ZINEの紙面感を出す。',
	},
	{
		id: 'g',
		title: 'G · スプリット',
		blurb: '左に特集だけを大きく。右にゲスト／日程／イベントを積む情報スタック。',
	},
	{
		id: 'h',
		title: 'H · カラーレール',
		blurb: '号カラーの縦帯＋正方形。グラフィック寄りで、遠目でも最新号だと分かる。',
	},
] as const;
---

<BaseLayout title="最新号／次回イベント 大幅デザイン案 | ニートマガジン">
	<section class="shell py-12 md:py-16">
		<p class="eyebrow">HOME / FEED REDESIGN</p>
		<h1 class="mt-3 text-3xl font-black md:text-4xl">最新号／次回イベント — 大幅案</h1>
		<p class="mt-4 max-w-2xl text-[var(--muted)]">
			正方形＋数字（または月日）は全案で維持。情報は変えず、レイアウトと階層だけを大きく振っています。
		</p>
		<p class="mt-2"><a href="/">← トップへ戻る</a> ／ <a href="/home-feed-design-tests">以前の微差案</a></p>

		<nav class="fd-nav mt-8">
			{variants.map((v) => (
				<a href={`#${v.id}`}>{v.id.toUpperCase()}</a>
			))}
		</nav>

		<div class="fd-list mt-12">
			{/* A · 現行 */}
			<section class="fd-item" id="a">
				<header class="fd-item__head">
					<h2 class="fd-item__title m-0">{variants[0].title}</h2>
					<p class="fd-item__blurb m-0">{variants[0].blurb}</p>
				</header>
				<div class="fd-preview">
					<HomeIntroBanner />
					<section class="home-feed fd-current grid gap-4 py-1 md:grid-cols-[minmax(0,2.1fr)_minmax(0,1fr)] md:gap-5 md:py-1.5">
						<div class="home-feed__col home-feed__col--latest">
							<p class="eyebrow">最新号</p>
							{mag && (
								<ArchiveCard
									title={feature || mag.data.title}
									description={currentDesc}
									href={magHref}
									accentColor={accent}
									volume={mag.data.volume}
								/>
							)}
						</div>
						<div class="home-feed__col home-feed__col--event">
							<p class="eyebrow">次回イベント</p>
							{ev && (
								<ArchiveCard
									title={ev.title}
									description={currentEventDesc}
									href={ev.href}
									meta={ev.meta}
									accentColor={EVENT_MARK}
									markDate={ev.date}
								/>
							)}
						</div>
					</section>
				</div>
			</section>

			{/* B · マストヘッド */}
			<section class="fd-item" id="b">
				<header class="fd-item__head">
					<h2 class="fd-item__title m-0">{variants[1].title}</h2>
					<p class="fd-item__blurb m-0">{variants[1].blurb}</p>
				</header>
				<div class="fd-preview">
					<HomeIntroBanner />
					<div class="fd-b fd-preview__feed">
					<a class="fd-b__issue" href={magHref} style={`--accent: ${accent}`}>
						<span class="fd-mark" aria-hidden="true">
							<span class="fd-mark__plate"></span>
							<span class="fd-mark__num">{volNum}</span>
						</span>
						<div class="fd-b__issue-main">
							<p class="fd-kicker">最新号 · 特集</p>
							<p class="fd-b__feature m-0">{feature}</p>
							<p class="fd-b__guests m-0">{guests.join(' ／ ')}</p>
						</div>
						<div class="fd-b__issue-meta">
							<p class="m-0">発売 {pub}</p>
							<p class="m-0">アーカイブ {arch}</p>
						</div>
					</a>
					{ev && (
						<a class="fd-b__event" href={ev.href} style={`--accent: ${EVENT_MARK}`}>
							<span class="fd-mark fd-mark--date" aria-hidden="true">
								<span class="fd-mark__plate"></span>
								<span class="fd-mark__date">{evParts?.month}/{evParts?.day}</span>
							</span>
							<div class="fd-b__event-body">
								<p class="fd-kicker">次回イベント</p>
								<p class="fd-b__event-title m-0">{ev.title}</p>
								<p class="fd-b__event-sub m-0">
									{ev.place}
									{ev.booth ? ` · ブース【${ev.booth}】` : ''}
								</p>
							</div>
						</a>
					)}
					</div>
				</div>
			</section>

			{/* C · 対称パネル */}
			<section class="fd-item" id="c">
				<header class="fd-item__head">
					<h2 class="fd-item__title m-0">{variants[2].title}</h2>
					<p class="fd-item__blurb m-0">{variants[2].blurb}</p>
				</header>
				<div class="fd-preview">
					<HomeIntroBanner />
					<div class="fd-c">
					<a class="fd-c__panel" href={magHref} style={`--accent: ${accent}`}>
						<div class="fd-c__top">
							<span class="fd-mark" aria-hidden="true">
								<span class="fd-mark__plate"></span>
								<span class="fd-mark__num">{volNum}</span>
							</span>
							<p class="fd-kicker m-0">最新号</p>
						</div>
						<p class="fd-c__hero m-0">{feature}</p>
						<div class="fd-c__foot">
							<p class="m-0">{guests.join('　')}</p>
							<p class="fd-c__dates m-0">{pub} → {arch}</p>
						</div>
					</a>
					{ev && (
						<a class="fd-c__panel fd-c__panel--event" href={ev.href} style={`--accent: ${EVENT_MARK}`}>
							<div class="fd-c__top">
								<span class="fd-mark fd-mark--date" aria-hidden="true">
									<span class="fd-mark__plate"></span>
									<span class="fd-mark__date">{evParts?.month}/{evParts?.day}</span>
								</span>
								<p class="fd-kicker m-0">次回イベント</p>
							</div>
							<p class="fd-c__hero m-0">{ev.booth ? `【${ev.booth}】` : ev.title}</p>
							<div class="fd-c__foot">
								<p class="m-0">{ev.title}</p>
								<p class="fd-c__dates m-0">{ev.place}</p>
							</div>
						</a>
					)}
					</div>
				</div>
			</section>

			{/* D · ポスター＋付箋 */}
			<section class="fd-item" id="d">
				<header class="fd-item__head">
					<h2 class="fd-item__title m-0">{variants[3].title}</h2>
					<p class="fd-item__blurb m-0">{variants[3].blurb}</p>
				</header>
				<div class="fd-preview">
					<HomeIntroBanner />
					<div class="fd-d">
					<a class="fd-d__poster" href={magHref} style={`--accent: ${accent}`}>
						<span class="fd-mark" aria-hidden="true">
							<span class="fd-mark__plate"></span>
							<span class="fd-mark__num">{volNum}</span>
						</span>
						<p class="fd-kicker">特集</p>
						<p class="fd-d__feature m-0">{feature}</p>
						<div class="fd-d__poster-bottom">
							<p class="m-0"><span class="fd-kicker">Guest</span> {guests.join(' / ')}</p>
							<p class="fd-d__meta m-0">発売 {pub}<br />公開 {arch}</p>
						</div>
					</a>
					{ev && (
						<a class="fd-d__note" href={ev.href} style={`--accent: ${EVENT_MARK}`}>
							<span class="fd-mark fd-mark--date" aria-hidden="true">
								<span class="fd-mark__plate"></span>
								<span class="fd-mark__date">{evParts?.month}/{evParts?.day}</span>
							</span>
							<p class="fd-kicker">Event</p>
							<p class="fd-d__note-title m-0">{ev.title}</p>
							<p class="fd-d__note-booth m-0">{ev.booth ? `【${ev.booth}】` : ''}</p>
							<p class="fd-d__note-place m-0">{ev.place}</p>
						</a>
					)}
					</div>
				</div>
			</section>

			{/* E · スケジュール板 */}
			<section class="fd-item" id="e">
				<header class="fd-item__head">
					<h2 class="fd-item__title m-0">{variants[4].title}</h2>
					<p class="fd-item__blurb m-0">{variants[4].blurb}</p>
				</header>
				<div class="fd-preview">
					<HomeIntroBanner />
					<div class="fd-e">
					<a class="fd-e__row" href={magHref} style={`--accent: ${accent}`}>
						<span class="fd-mark" aria-hidden="true">
							<span class="fd-mark__plate"></span>
							<span class="fd-mark__num">{volNum}</span>
						</span>
						<div class="fd-e__when">
							<span>発売</span>
							<strong>{pub}</strong>
						</div>
						<div class="fd-e__what">
							<span class="fd-kicker">最新号 特集</span>
							<strong>{feature}</strong>
							<span>{guests.join('　')}</span>
						</div>
					</a>
					<a class="fd-e__row" href={magHref} style={`--accent: ${accent}`}>
						<span class="fd-mark fd-mark--ghost" aria-hidden="true">
							<span class="fd-mark__plate"></span>
							<span class="fd-mark__num">AR</span>
						</span>
						<div class="fd-e__when">
							<span>アーカイブ</span>
							<strong>{arch}</strong>
						</div>
						<div class="fd-e__what">
							<span class="fd-kicker">デジタル公開</span>
							<strong>Vol.{volNum} 全文公開</strong>
						</div>
					</a>
					{ev && (
						<a class="fd-e__row" href={ev.href} style={`--accent: ${EVENT_MARK}`}>
							<span class="fd-mark fd-mark--date" aria-hidden="true">
								<span class="fd-mark__plate"></span>
								<span class="fd-mark__date">{evParts?.month}/{evParts?.day}</span>
							</span>
							<div class="fd-e__when">
								<span>出店</span>
								<strong>{ev.meta}</strong>
							</div>
							<div class="fd-e__what">
								<span class="fd-kicker">次回イベント</span>
								<strong>{ev.title}{ev.booth ? ` 【${ev.booth}】` : ''}</strong>
								<span>{ev.place}</span>
							</div>
						</a>
					)}
					</div>
				</div>
			</section>

			{/* F · 誌面ゲラ */}
			<section class="fd-item" id="f">
				<header class="fd-item__head">
					<h2 class="fd-item__title m-0">{variants[5].title}</h2>
					<p class="fd-item__blurb m-0">{variants[5].blurb}</p>
				</header>
				<div class="fd-preview">
					<HomeIntroBanner />
					<div class="fd-f">
					<a class="fd-f__col" href={magHref} style={`--accent: ${accent}`}>
						<div class="fd-f__rule">
							<span class="fd-mark" aria-hidden="true">
								<span class="fd-mark__plate"></span>
								<span class="fd-mark__num">{volNum}</span>
							</span>
							<span>LATEST / FEATURE</span>
						</div>
						<p class="fd-f__feature m-0">{feature}</p>
						<dl class="fd-f__dl">
							<div><dt>GUEST</dt><dd>{guests.join(' / ')}</dd></div>
							<div><dt>ONSALE</dt><dd>{pub}</dd></div>
							<div><dt>ARCHIVE</dt><dd>{arch}</dd></div>
						</dl>
					</a>
					{ev && (
						<a class="fd-f__col" href={ev.href} style={`--accent: ${EVENT_MARK}`}>
							<div class="fd-f__rule">
								<span class="fd-mark fd-mark--date" aria-hidden="true">
									<span class="fd-mark__plate"></span>
									<span class="fd-mark__date">{evParts?.month}/{evParts?.day}</span>
								</span>
								<span>NEXT EVENT</span>
							</div>
							<p class="fd-f__feature m-0">{ev.title}</p>
							<dl class="fd-f__dl">
								<div><dt>BOOTH</dt><dd>{ev.booth ? `【${ev.booth}】` : '—'}</dd></div>
								<div><dt>PLACE</dt><dd>{ev.place}</dd></div>
								<div><dt>DATE</dt><dd>{ev.meta}</dd></div>
							</dl>
						</a>
					)}
					</div>
				</div>
			</section>

			{/* G · スプリット */}
			<section class="fd-item" id="g">
				<header class="fd-item__head">
					<h2 class="fd-item__title m-0">{variants[6].title}</h2>
					<p class="fd-item__blurb m-0">{variants[6].blurb}</p>
				</header>
				<div class="fd-preview">
					<HomeIntroBanner />
					<div class="fd-g">
					<a class="fd-g__feature" href={magHref} style={`--accent: ${accent}`}>
						<span class="fd-mark" aria-hidden="true">
							<span class="fd-mark__plate"></span>
							<span class="fd-mark__num">{volNum}</span>
						</span>
						<p class="fd-kicker">特集</p>
						<p class="fd-g__feature-text m-0">{feature}</p>
					</a>
					<div class="fd-g__stack">
						<a class="fd-g__card" href={magHref}>
							<p class="fd-kicker">スペシャルゲスト</p>
							<p class="fd-g__guests m-0">{guests.join('　')}</p>
							<p class="fd-g__dates m-0">発売 {pub}　／　公開 {arch}</p>
						</a>
						{ev && (
							<a class="fd-g__card fd-g__card--event" href={ev.href} style={`--accent: ${EVENT_MARK}`}>
								<span class="fd-mark fd-mark--date" aria-hidden="true">
									<span class="fd-mark__plate"></span>
									<span class="fd-mark__date">{evParts?.month}/{evParts?.day}</span>
								</span>
								<div>
									<p class="fd-kicker">次回イベント</p>
									<p class="fd-g__event-title m-0">{ev.title}</p>
									<p class="fd-g__event-sub m-0">
										{ev.booth ? `【${ev.booth}】 · ` : ''}
										{ev.place}
									</p>
								</div>
							</a>
						)}
					</div>
					</div>
				</div>
			</section>

			{/* H · カラーレール */}
			<section class="fd-item" id="h">
				<header class="fd-item__head">
					<h2 class="fd-item__title m-0">{variants[7].title}</h2>
					<p class="fd-item__blurb m-0">{variants[7].blurb}</p>
				</header>
				<div class="fd-preview">
					<HomeIntroBanner />
					<div class="fd-h">
					<a class="fd-h__rail" href={magHref} style={`--accent: ${accent}`}>
						<span class="fd-h__bar" aria-hidden="true"></span>
						<span class="fd-mark" aria-hidden="true">
							<span class="fd-mark__plate"></span>
							<span class="fd-mark__num">{volNum}</span>
						</span>
						<div class="fd-h__body">
							<p class="fd-kicker">最新号</p>
							<p class="fd-h__feature m-0">{feature}</p>
							<p class="fd-h__sub m-0">{guests.join('　')} · 発売 {pub} · 公開 {arch}</p>
						</div>
					</a>
					{ev && (
						<a class="fd-h__rail fd-h__rail--event" href={ev.href} style={`--accent: ${EVENT_MARK}`}>
							<span class="fd-h__bar" aria-hidden="true"></span>
							<span class="fd-mark fd-mark--date" aria-hidden="true">
								<span class="fd-mark__plate"></span>
								<span class="fd-mark__date">{evParts?.month}/{evParts?.day}</span>
							</span>
							<div class="fd-h__body">
								<p class="fd-kicker">次回イベント</p>
								<p class="fd-h__feature m-0">{ev.title}</p>
								<p class="fd-h__sub m-0">
									{ev.booth ? `ブース【${ev.booth}】 · ` : ''}
									{ev.place}
								</p>
							</div>
						</a>
					)}
					</div>
				</div>
			</section>
		</div>
	</section>
</BaseLayout>

<style is:global>
	.fd-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.06em;
	}
	.fd-list { display: grid; gap: 3.5rem; }
	.fd-item__head { margin-bottom: 0.85rem; }
	.fd-item__title { font-size: 1.1rem; font-weight: 800; letter-spacing: -0.02em; }
	.fd-item__blurb { color: var(--muted); font-size: 0.88rem; line-height: 1.55; margin-top: 0.25rem; }
	.fd-preview {
		border: 1px solid var(--line);
		overflow: hidden;
		padding: 0.85rem 1rem 1rem;
	}
	.fd-preview .home-intro {
		aspect-ratio: auto;
		min-height: 0;
	}
	.fd-preview__feed,
	.fd-preview > .fd-b,
	.fd-preview > .fd-c,
	.fd-preview > .fd-d,
	.fd-preview > .fd-e,
	.fd-preview > .fd-f,
	.fd-preview > .fd-g,
	.fd-preview > .fd-h,
	.fd-preview > .home-feed {
		margin-top: 0.75rem;
	}
	.fd-kicker {
		color: var(--muted);
		font-size: 0.66rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		margin: 0 0 0.35rem;
		text-transform: uppercase;
	}

	/* shared mark (ArchiveCard 相当) */
	.fd-mark {
		display: grid;
		flex-shrink: 0;
		overflow: hidden;
		position: relative;
		width: 3.15rem;
	}
	.fd-mark__plate {
		aspect-ratio: 1;
		background: var(--accent);
		display: block;
		grid-area: 1 / 1;
		width: 100%;
	}
	.fd-mark__num,
	.fd-mark__date {
		align-items: center;
		color: #fff;
		display: flex;
		font-family: "Noto Serif JP", "Hiragino Mincho ProN", "Yu Mincho", serif;

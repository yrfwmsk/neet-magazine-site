---
import { getCollection } from 'astro:content';
import BookstoreList from '../components/BookstoreList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { comparePrefecture } from '../lib/prefecture';

const bookstores = await getCollection('bookstores');

const sortBookstores = (
	a: (typeof bookstores)[number],
	b: (typeof bookstores)[number],
) => {
	const byPrefecture = comparePrefecture(a.data.prefecture, b.data.prefecture);
	if (byPrefecture !== 0) return byPrefecture;
	if (a.data.order !== b.data.order) return a.data.order - b.data.order;
	return a.data.name.localeCompare(b.data.name, 'ja');
};

const sortArchived = (
	a: (typeof bookstores)[number],
	b: (typeof bookstores)[number],
) => {
	const aEnd = a.data.endedAt?.valueOf() ?? 0;
	const bEnd = b.data.endedAt?.valueOf() ?? 0;
	if (aEnd !== bEnd) return bEnd - aEnd;
	return sortBookstores(a, b);
};

const active = bookstores.filter((store) => store.data.status === 'active').sort(sortBookstores);
const archived = bookstores.filter((store) => store.data.status === 'archived').sort(sortArchived);
---

<BaseLayout
	title="取扱書店 | ニートマガジン"
	description="冊子版ニートマガジンの取扱書店一覧です。"
>
	<PageHero label="STORES" title="取扱書店" />
	<section class="shell pb-16 md:pb-24">
		<p class="max-w-xl text-[var(--muted)]">
			冊子版ニートマガジンをお取り扱いいただいている書店の一覧です。
		</p>
		<aside class="store-notice mt-8 max-w-2xl" role="note" aria-label="在庫に関するご注意">
			<svg class="store-notice__icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
				<circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" />
				<path d="M12 8v5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
				<circle cx="12" cy="16" r="1" fill="currentColor" />
			</svg>
			<div class="store-notice__body">
				<p>掲載されている書店でも、店頭に冊子があるとは限りません。</p>
				<p>お買い求めの際は、お手数ですが取扱店へ在庫のご確認をお願いします。</p>
				<p>在庫についてのお問い合わせは、こちらではお答えできません。</p>
			</div>
		</aside>

		<div class="mt-14 max-w-3xl">
			<h2 class="store-section-title">
				<span class="store-section-title__text">現在の取扱書店</span>
				<span class="store-section-note">（都道府県順）</span>
			</h2>
			{
				active.length > 0 ? (
					<BookstoreList items={active} />
				) : (
					<p class="store-empty">現在、掲載できる取扱書店はありません。</p>
				)
			}

			{
				archived.length > 0 && (
					<div class="mt-16">
						<h2 class="store-section-title">過去の取扱書店</h2>
						<p class="store-archive-note">
							これまでお取り扱いいただいた書店の記録です。
						</p>
						<BookstoreList items={archived} archived />
					</div>
				)
			}
		</div>

		<p class="mt-12 max-w-xl text-sm text-[var(--muted)]">
			取扱に関するお問い合わせは<a href="/contact">お問い合わせ</a>フォームからご連絡ください。
		</p>
	</section>
</BaseLayout>

<style>
	.store-notice {
		align-items: flex-start;
		background: var(--panel);
		border: 1px solid var(--line);
		display: flex;
		gap: 0.75rem;
		padding: 1rem 1.15rem;
	}

	.store-notice__icon {
		color: var(--ink);
		flex-shrink: 0;
		margin-top: 0.1rem;
	}

	.store-notice__body {
		color: var(--ink);
		font-size: 0.9rem;
		line-height: 1.8;
	}

	.store-notice__body p {
		margin: 0;
	}

	.store-notice__body p + p {
		margin-top: 0.55rem;
	}

	.store-section-title {
		align-items: baseline;
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
		margin: 0 0 1rem;
	}

	.store-section-title__text,
	.store-section-title:not(:has(.store-section-note)) {
		font-family: "Noto Serif JP", "Hiragino Mincho ProN", "Yu Mincho", serif;
		font-size: 1.15rem;
		font-weight: 900;
		letter-spacing: -0.03em;
		line-height: 1.3;
		transform: scaleX(0.97);
		transform-origin: left center;
	}

	.store-section-note {
		color: var(--muted);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.03em;
		line-height: 1;
		white-space: nowrap;
	}

	.store-archive-note {
		color: var(--ink);
		font-size: 0.9rem;
		line-height: 1.7;
		margin: 0 0 1rem;
		max-width: 46rem;
	}

	.store-empty {
		border-top: 1px solid var(--line);
		color: var(--muted);
		font-size: 0.95rem;
		margin: 0;
		max-width: 46rem;
		padding: 1.35rem 0;
	}
</style>

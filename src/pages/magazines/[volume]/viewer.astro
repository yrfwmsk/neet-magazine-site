---
import { getCollection } from 'astro:content';
import PdfViewer from '../../../components/PdfViewer.astro';
import { isArchiveAvailable } from '../../../lib/archive';
import { formatDateJa } from '../../../lib/date';

export async function getStaticPaths() {
	const magazines = await getCollection('magazines');
	return magazines
		.filter((magazine) => Boolean(magazine.data.pdfPath))
		.map((magazine) => ({ params: { volume: magazine.data.volume }, props: { magazine } }));
}

const { magazine } = Astro.props;
const archiveAvailable = isArchiveAvailable(magazine.data.archiveAt);
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={`${magazine.data.title} のPDFビューア`} />
		<meta name="robots" content="noindex, nofollow" />
		<link rel="canonical" href={`https://neet-magazine.com/magazines/${magazine.data.volume}`} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<title>{magazine.data.title} PDFビューア | ニートマガジン</title>
		<style>
			html,
			body {
				margin: 0;
				height: 100%;
				background: #1a1a1a;
				color: #f5f2f2;
				font-family: system-ui, sans-serif;
			}
			.viewer-locked {
				box-sizing: border-box;
				display: grid;
				gap: 1rem;
				margin: 0 auto;
				max-width: 28rem;
				min-height: 100%;
				padding: 2rem 1.25rem;
				place-content: center;
			}
			.viewer-locked h1 {
				font-size: 1.25rem;
				font-weight: 700;
				line-height: 1.5;
				margin: 0;
			}
			.viewer-locked p {
				color: #b8b0b2;
				line-height: 1.7;
				margin: 0;
			}
			.viewer-locked a {
				color: #f5f2f2;
			}
		</style>
	</head>
	<body>
		{archiveAvailable ? (
			<PdfViewer
				pdfPath={magazine.data.pdfPath!}
				title={magazine.data.title}
				backHref={`/magazines/${magazine.data.volume}`}
			/>
		) : (
			<div class="viewer-locked">
				<h1>PDFはまだ公開されていません</h1>
				<p>
					{magazine.data.archiveAt
						? `Webアーカイブ公開日（${formatDateJa(magazine.data.archiveAt)}）以降に閲覧できます。`
						: 'Webアーカイブ公開後に閲覧できます。'}
				</p>
				<p><a href={`/magazines/${magazine.data.volume}`}>← {magazine.data.volume} へ戻る</a></p>
			</div>
		)}
	</body>
</html>

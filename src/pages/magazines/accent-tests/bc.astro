---
import AccentTestNav from '../../../components/AccentTestNav.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAccentTestMagazines, volumeLabel } from '../../../lib/accent-test';
import { formatDate } from '../../../lib/date';

const magazines = await getAccentTestMagazines();

function markInk(hex: string): string {
	const r = Number.parseInt(hex.slice(1, 3), 16);
	const g = Number.parseInt(hex.slice(3, 5), 16);
	const b = Number.parseInt(hex.slice(5, 7), 16);
	const luminance = (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255;
	return luminance > 0.58 ? '#171717' : '#fdfdfc';
}
---

<BaseLayout title="アクセント案 B+C · 色面×号数字 | ニートマガジン">
	<section class="shell py-16 md:py-24">
		<p class="eyebrow">TEST B+C</p>
		<h1 class="mt-4 text-3xl font-black md:text-4xl">色面 × 号数字</h1>
		<p class="mt-4 max-w-xl text-sm text-[var(--muted)]">
			Bの正方形色面を小さくし、その上に C の号数字（Noto Serif JP）を重ねた融合案。本番のバックナンバーにも反映済み。
		</p>
		<AccentTestNav current="bc" />

		<div class="test-bc mt-12">
			{magazines.map((magazine) => (
				<article
					class="test-bc__item"
					style={`--accent: ${magazine.accentColor}; --mark-ink: ${markInk(magazine.accentColor)}`}
				>
					<a class="test-bc__mark" href={magazine.href} aria-hidden="true" tabindex="-1">
						<span class="test-bc__plate"></span>
						<span class="test-bc__num">{volumeLabel(magazine.volume)}</span>
					</a>
					<div class="test-bc__body">
						<h2 class="test-bc__title">
							<a href={magazine.href}>{magazine.title}</a>
						</h2>
						<p class="test-bc__desc">{magazine.summary}</p>
						<p class="test-bc__meta">{formatDate(magazine.publishedAt)}</p>
					</div>
				</article>
			))}
		</div>
	</section>
</BaseLayout>

<style>
	.test-bc {
		display: grid;
		gap: 0;
	}

	@media (min-width: 768px) {
		.test-bc {
			grid-template-columns: 1fr 1fr;
			column-gap: 3.5rem;
		}
	}

	.test-bc__item {
		align-items: center;
		border-top: 1px solid var(--line);
		display: flex;
		gap: 1rem;
		padding: 1.75rem 0 2rem;
	}

	.test-bc__mark {
		display: grid;
		flex-shrink: 0;
		place-items: center;
		text-decoration: none;
		width: 3rem;
	}

	.test-bc__plate {
		aspect-ratio: 1;
		background: var(--accent);
		display: block;
		grid-area: 1 / 1;
		width: 100%;
	}

	.test-bc__num {
		color: var(--mark-ink);
		font-family: "Noto Serif JP", "Hiragino Mincho ProN", "Yu Mincho", serif;
		font-size: 2.35rem;
		font-weight: 900;
		grid-area: 1 / 1;
		letter-spacing: -0.08em;
		line-height: 1;
		position: relative;
		transform: scaleX(0.62);
		transform-origin: center;
	}

	.test-bc__body {
		min-width: 0;
	}

	.test-bc__title {
		font-size: 1.15rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.45;
		margin: 0;
	}

	.test-bc__desc {
		color: var(--muted);
		font-size: 0.9rem;
		line-height: 1.7;
		margin: 0.5rem 0 0;
	}

	.test-bc__meta {
		color: var(--muted);
		font-size: 0.8rem;
		margin: 0.85rem 0 0;
	}

	@media (min-width: 768px) {
		.test-bc__mark {
			width: 3.25rem;
		}

		.test-bc__num {
			font-size: 2.65rem;
			transform: scaleX(0.58);
		}
	}
</style>

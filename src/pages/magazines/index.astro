---
import { getCollection } from 'astro:content';
import ArchiveCard from '../../components/ArchiveCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Search from '../../components/Search.astro';
import { VOLUME_ACCENTS } from '../../lib/accent-test';
import { isVolumeArchiveAvailable } from '../../lib/archive';
import { formatDate } from '../../lib/date';
import { plainSearchText } from '../../lib/search-text';

const magazines = (await getCollection('magazines')).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const archiveAtByVolume = new Map(magazines.map((magazine) => [magazine.data.volume, magazine.data.archiveAt]));
const articles = await getCollection('articles');
const searchItems = articles
	.filter((article) => isVolumeArchiveAvailable(article.data.volume, archiveAtByVolume))
	.map((article) => ({
	title: article.data.title,
	author: article.data.author,
	volume: article.data.volume,
	body: plainSearchText(article.body),
	href: `/magazines/${article.data.volume}/${article.id.split('/').at(-1)}`,
}));
---

<BaseLayout title="バックナンバー | ニートマガジン">
	<PageHero label="ARCHIVE" title="バックナンバー" />
	<section class="shell pb-16 md:pb-24">
		<p class="max-w-2xl text-[var(--muted)]">「どんなに金欠の無職ニートでもアクセスできる情報源でありたい」というポリシーのもと、冊子版をデジタルアーカイブとして公開しています。</p>
		<Search items={searchItems} />
		<div class="archive-list mt-14">
			{magazines.map((magazine) => (
				<ArchiveCard
					layout="strip"
					stripContent="issue"
					title={magazine.data.title}
					description={magazine.data.summary}
					featureTitle={magazine.data.featureTitle}
					guests={magazine.data.guests}
					href={`/magazines/${magazine.data.volume}`}
					meta={formatDate(magazine.data.publishedAt)}
					accentColor={VOLUME_ACCENTS[magazine.data.volume] ?? magazine.data.accentColor}
					volume={magazine.data.volume}
				/>
			))}
		</div>
	</section>
</BaseLayout>

<style>
	@media (max-width: 759px) {
		.archive-list :global(.archive-card--strip-issue .archive-card__highlight-col--feature),
		.archive-list :global(.archive-card--strip-issue .archive-card__highlight-col--guest) {
			display: none;
		}

		.archive-list :global(.archive-card--strip-issue .archive-card__highlights-squeeze) {
			min-width: 0;
			overflow: hidden;
		}

		.archive-list :global(.archive-card--strip-issue .archive-card__highlights-grid--issue) {
			grid-template-columns: minmax(0, 1fr);
			transform: none;
			width: 100%;
		}

		.archive-list :global(.archive-card--strip-issue .archive-card__highlight-col--intro) {
			min-width: 0;
			overflow: hidden;
		}

		.archive-list :global(.archive-card--strip-issue .archive-card__intro-text) {
			--intro-squeeze: 0.7;
			display: inline-block;
			transform: scaleX(var(--intro-squeeze));
			transform-origin: left center;
			white-space: nowrap;
			width: calc(100% / var(--intro-squeeze));
		}
	}
</style>

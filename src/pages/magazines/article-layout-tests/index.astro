---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LAYOUT_TESTS } from '../../../lib/article-layout-test';
---

<BaseLayout title="記事レイアウト案テスト | ニートマガジン">
	<section class="shell py-16 md:py-24">
		<p class="eyebrow">DESIGN TESTS</p>
		<h1 class="mt-4 text-4xl font-black md:text-5xl">記事ページ · レイアウト案</h1>
		<p class="mt-6 max-w-2xl text-[var(--muted)]">
			ヘッダー幅（ロゴ〜テーマ切替）に記事を収めつつ、右サイドの記事一覧をどう扱うかの比較です。本番の記事ページには未反映です。
		</p>

		<ul class="mt-10 list-none space-y-0 p-0">
			{LAYOUT_TESTS.map((test) => (
				<li class="border-t border-[var(--line)] py-6">
					<a class="text-xl font-bold no-underline" href={test.href}>{test.title}</a>
					<p class="mt-2 mb-0 max-w-xl text-sm text-[var(--muted)]">{test.blurb}</p>
				</li>
			))}
		</ul>

		<p class="mt-8 text-sm text-[var(--muted)]">
			比較用タイトルは「35歳過ぎたニートがこの10年で感じたこと」（やや長め）。
			<br />
			<a href="/magazines/vol2/ten-years">← 本番の同記事へ</a>
		</p>
	</section>
</BaseLayout>

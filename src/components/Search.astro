---
interface SearchItem {
	title: string;
	author: string;
	body: string;
	href: string;
	volume: string;
}
interface Props {
	items: SearchItem[];
	variant?: 'default' | 'compact';
}
const { items, variant = 'default' } = Astro.props;
---

<section class:list={['article-search', { 'article-search--compact': variant === 'compact' }]} aria-label="記事検索">
	<div class="article-search__field">
		<label for="archive-search" class="article-search__label">SEARCH ARTICLES</label>
		<div class="article-search__input-wrap">
			<svg class="article-search__icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
				<circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" />
				<path d="M20 20l-4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
			</svg>
			<input id="archive-search" type="search" class="article-search__input" placeholder="著者名、タイトル、ワードで検索" autocomplete="off" />
		</div>
	</div>
	<div class="article-search__feedback">
		<p id="search-status" class="article-search__status" aria-live="polite"></p>
		<ul id="search-results" class="article-search__results"></ul>
	</div>
</section>

<script define:vars={{ items }}>
	const input = document.querySelector('#archive-search');
	const results = document.querySelector('#search-results');
	const status = document.querySelector('#search-status');
	input?.addEventListener('input', () => {
		const query = input.value.trim().toLocaleLowerCase('ja');
		if (!query) {
			results.innerHTML = '';
			status.textContent = '';
			return;
		}
		const matched = items.filter((item) =>
			[item.title, item.author, item.body].join(' ').toLocaleLowerCase('ja').includes(query),
		);
		status.textContent = `${matched.length}件の記事`;
		results.innerHTML = matched.map((item) =>
			`<li><a href="${item.href}">${item.title}</a> <span class="article-search__meta">— ${item.author} / ${item.volume}</span></li>`,
		).join('');
	});
</script>

<style>
	.article-search {
		margin-top: 3rem;
		max-width: 32rem;
	}
	.article-search__field {
		padding: 0;
	}
	.article-search__label {
		color: var(--muted);
		display: block;
		font: 700 .62rem/1.2 monospace;
		letter-spacing: .16em;
	}
	.article-search__input-wrap {
		align-items: center;
		border-bottom: 1px solid var(--line);
		display: flex;
		gap: .5rem;
		margin-top: .35rem;
		transition: border-color .2s ease;
	}
	.article-search__input-wrap:focus-within {
		border-bottom-color: var(--ink);
	}
	.article-search__icon {
		color: var(--muted);
		flex-shrink: 0;
		opacity: .7;
	}
	.article-search__input {
		background: transparent;
		border: 0;
		border-radius: 0;
		display: block;
		flex: 1;
		font: inherit;
		font-size: 1.05rem;
		min-width: 0;
		padding: .65rem 0;
		width: 100%;
	}
	.article-search__input::placeholder {
		color: var(--muted);
		opacity: .65;
	}
	.article-search__input::-webkit-search-cancel-button {
		-webkit-appearance: none;
	}
	.article-search__input:focus {
		outline: none;
	}
	.article-search__status {
		color: var(--muted);
		font-size: .875rem;
		margin: .75rem 0 0;
	}
	.article-search__results {
		list-style: none;
		margin: 1rem 0 0;
		padding: 0;
	}
	.article-search__results :global(a) {
		color: var(--ink);
		font-weight: 700;
		text-decoration: none;
	}
	.article-search__results :global(.article-search__meta) {
		color: var(--muted);
	}
	.article-search__results :global(li + li) {
		margin-top: .75rem;
	}

	.article-search--compact {
		margin-top: 1.6rem;
		max-width: 21rem;
		position: relative;
		width: 100%;
		z-index: 2;
	}
	.article-search--compact .article-search__field {
		border: 0;
		padding: 0;
	}
	.article-search--compact .article-search__label {
		color: #555;
		font-size: .56rem;
		letter-spacing: .16em;
	}
	.article-search--compact .article-search__input-wrap {
		border-bottom: 1px solid #777;
		gap: .35rem;
		margin-top: .2rem;
	}
	.article-search--compact .article-search__icon {
		color: #777;
		height: .85rem;
		width: .85rem;
	}
	.article-search--compact .article-search__input {
		font-size: .72rem;
		padding: .45rem 0;
	}
	.article-search--compact .article-search__input::placeholder {
		color: #777;
		opacity: 1;
	}
	.article-search--compact .article-search__feedback {
		background: var(--page);
		border: 1px solid var(--line);
		box-shadow: 0 8px 20px color-mix(in srgb, #000 22%, transparent);
		color: var(--ink);
		left: 0;
		max-height: min(18rem, 45vh);
		overflow-y: auto;
		position: absolute;
		top: 100%;
		width: 100%;
		z-index: 5;
	}
	.article-search--compact .article-search__status {
		font: .65rem/1.4 monospace;
		margin: 0;
		padding: .6rem .75rem 0;
	}
	.article-search--compact .article-search__results {
		font-size: .72rem;
		line-height: 1.5;
		margin: 0;
		padding: .5rem .75rem .75rem;
	}
	.article-search--compact .article-search__results:empty,
	.article-search--compact .article-search__status:empty {
		display: none;
	}
	.article-search--compact .article-search__feedback:has(#search-status:empty):has(#search-results:empty) {
		display: none;
	}
</style>

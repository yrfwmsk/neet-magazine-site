---
import { emdashHtml } from '../lib/emdash';

interface Props {
	/** 単一ラベル（後方互換）。eyebrows がある場合は無視 */
	eyebrow?: string;
	/** 複数ラベル（スペシャルゲスト＋特集など）。中黒で併記 */
	eyebrows?: string[];
	title: string;
	description?: string;
	href: string;
	meta?: string;
	accentColor?: string;
	/** e.g. "vol1" — used for the volume mark */
	volume?: string;
	/** イベント用: 正方形に月日を2段表示 */
	markDate?: Date;
	/** strip: 1列の横長行。stack: 従来の縦積み */
	layout?: 'stack' | 'strip';
	/** strip 時の表示種別。issue は号一覧（タイトル非表示・特集/ゲスト優先） */
	stripContent?: 'issue';
	/** バックナンバー strip 用: 特集タイトル */
	featureTitle?: string;
	/** バックナンバー strip 用: スペシャルゲスト名 */
	guests?: string[];
	/** true のときリンクを無効化（アーカイブ公開前など） */
	disabled?: boolean;
}

const {
	eyebrow,
	eyebrows,
	title,
	description,
	href,
	meta,
	accentColor,
	volume,
	markDate,
	layout = 'stack',
	stripContent,
	featureTitle,
	guests,
	disabled = false,
} = Astro.props;

const volumeNumberRaw = volume?.replace(/^vol/i, '') ?? '';
const volumeNumber = volumeNumberRaw ? volumeNumberRaw.padStart(2, '0') : '';
const showMark = Boolean(accentColor);
const showNumber = Boolean(volumeNumber) && !markDate;
const showDateMark = Boolean(markDate);
/** 『「などの開き括弧は字面左に空きがあるので、見出し開始位置を光学的に揃える */
const titleStartsWithOpenBracket = /^[『「]/.test(title);
const labels = (eyebrows?.length ? eyebrows : eyebrow ? [eyebrow] : []).filter(Boolean);
const titleHtml = emdashHtml(title);
const descriptionHtml = description ? emdashHtml(description) : undefined;
const guestNames = guests?.filter(Boolean) ?? [];
const isIssueStrip = layout === 'strip' && stripContent === 'issue';
const featureTitleHtml = featureTitle ? emdashHtml(featureTitle) : undefined;

const markMonth = markDate ? String(markDate.getUTCMonth() + 1).padStart(2, '0') : '';
const markDay = markDate ? String(markDate.getUTCDate()).padStart(2, '0') : '';
---

<article
	class:list={[
		'archive-card',
		showMark && 'archive-card--accent',
		layout === 'strip' && 'archive-card--strip',
		isIssueStrip && 'archive-card--strip-issue',
		showDateMark && 'archive-card--date',
		disabled && 'archive-card--disabled',
	]}
	style={accentColor ? `--accent: ${accentColor}` : undefined}
>
	{showMark && (
		disabled ? (
			<span class="archive-card__mark" aria-hidden="true">
				<span class="archive-card__plate"></span>
				{showNumber && (
					<span class="archive-card__num">
						<span class="archive-card__num-glyph">{volumeNumber}</span>
					</span>
				)}
				{showDateMark && (
					<span class="archive-card__date">
						<span class="archive-card__date-month">{markMonth}</span>
						<span class="archive-card__date-slash" aria-hidden="true">/</span>
						<span class="archive-card__date-day">{markDay}</span>
					</span>
				)}
			</span>
		) : (
			<a class="archive-card__mark" href={href} aria-hidden="true" tabindex="-1">
				<span class="archive-card__plate"></span>
				{showNumber && (
					<span class="archive-card__num">
						<span class="archive-card__num-glyph">{volumeNumber}</span>
					</span>
				)}
				{showDateMark && (
					<span class="archive-card__date">
						<span class="archive-card__date-month">{markMonth}</span>
						<span class="archive-card__date-slash" aria-hidden="true">/</span>
						<span class="archive-card__date-day">{markDay}</span>
					</span>
				)}
			</a>
		)
	)}
	<div class="archive-card__body">
		{labels.length > 0 && (
			<p class="archive-card__eyebrows eyebrow mb-1.5">
				{labels.map((label) => (
					<span class="archive-card__eyebrow-label">{label}</span>
				))}
			</p>
		)}
		<div class="archive-card__main">
			{isIssueStrip ? (
				<h2 class="archive-card__highlights m-0">
					<div class="archive-card__highlights-squeeze">
						{disabled ? (
							<span class="archive-card__highlights-grid archive-card__highlights-grid--issue">
								<span class="archive-card__highlight-col archive-card__highlight-col--intro">
									{descriptionHtml && (
										<span class="archive-card__intro-text" set:html={descriptionHtml} />
									)}
								</span>
								<span class="archive-card__highlight-col archive-card__highlight-col--feature">
									{featureTitleHtml && (
										<>
											<span class="archive-card__highlight-label">特集</span>
											<span class="archive-card__highlight-text" set:html={featureTitleHtml} />
										</>
									)}
								</span>
								<span class="archive-card__highlight-col archive-card__highlight-col--guest">
									{guestNames.length > 0 && (
										<>
											<span class="archive-card__highlight-label">スペシャルゲスト</span>
											<span class="archive-card__highlight-text">{guestNames.join('／')}</span>
										</>
									)}
								</span>
							</span>
						) : (
							<a class="archive-card__highlights-grid archive-card__highlights-grid--issue" href={href} aria-label={title}>
								<span class="archive-card__highlight-col archive-card__highlight-col--intro">
									{descriptionHtml && (
										<span class="archive-card__intro-text" set:html={descriptionHtml} />
									)}
								</span>
								<span class="archive-card__highlight-col archive-card__highlight-col--feature">
									{featureTitleHtml && (
										<>
											<span class="archive-card__highlight-label">特集</span>
											<span class="archive-card__highlight-text" set:html={featureTitleHtml} />
										</>
									)}
								</span>
								<span class="archive-card__highlight-col archive-card__highlight-col--guest">
									{guestNames.length > 0 && (
										<>
											<span class="archive-card__highlight-label">スペシャルゲスト</span>
											<span class="archive-card__highlight-text">{guestNames.join('／')}</span>
										</>
									)}
								</span>
							</a>
						)}
					</div>
				</h2>
			) : (
				<>
					{!isIssueStrip && (
						<h2 class:list={['archive-card__title', 'm-0', titleStartsWithOpenBracket && 'archive-card__title--hang']}>
							{disabled ? <span set:html={titleHtml} /> : <a href={href} set:html={titleHtml} />}
						</h2>
					)}
					{descriptionHtml && <p class="archive-card__desc" set:html={descriptionHtml} />}
				</>
			)}
		</div>
		{meta && <p class="archive-card__meta" set:html={meta} />}
	</div>
</article>

<style>
	.archive-card {
		align-items: center;
		border-bottom: 1px solid var(--line);
		border-top: 1px solid var(--line);
		display: flex;
		gap: 0.95rem;
		height: 100%;
		padding-block: 1.75rem;
	}

	.archive-card + .archive-card {
		border-top: none;
	}

	.archive-card--disabled {
		cursor: default;
	}

	.archive-card--disabled .archive-card__title a,
	.archive-card--disabled .archive-card__title span {
		color: inherit;
		cursor: default;
		text-decoration: none;
	}

	.archive-card--disabled .archive-card__mark {
		cursor: default;
	}

	.archive-card__mark {
		display: grid;
		flex-shrink: 0;
		overflow: hidden;
		position: relative;
		text-decoration: none;
		width: 3rem;
	}

	.archive-card__plate {
		aspect-ratio: 1;
		background: var(--accent);
		display: block;
		grid-area: 1 / 1;
		width: 100%;
	}

	.archive-card__num {
		display: block;
		grid-area: 1 / 1;
		height: 100%;
		overflow: hidden;
		position: relative;
		user-select: none;
		width: 100%;
	}

	.archive-card__num-glyph {
		color: #fff;
		display: block;
		font-family: "Noto Serif JP", "Hiragino Mincho ProN", "Yu Mincho", serif;
		/* 日付マーク（.archive-card__date-*）と同じ字面サイズ・横圧縮 */
		font-size: 0.95rem;
		font-variant-numeric: tabular-nums;
		font-weight: 900;
		left: 50%;
		letter-spacing: -0.04em;
		line-height: 1;
		position: absolute;
		top: 50%;
		transform:
			translate(calc(-50% + var(--num-nudge-x, 0px)), calc(-50% - 0.06em))
			scaleX(0.78);
		transform-origin: center;
		white-space: nowrap;
	}

	.archive-card__date {
		align-items: center;
		color: #fff;
		display: flex;
		font-family: "Noto Serif JP", "Hiragino Mincho ProN", "Yu Mincho", serif;
		font-variant-numeric: tabular-nums;
		font-weight: 900;
		grid-area: 1 / 1;
		height: 100%;
		justify-content: center;
		letter-spacing: -0.04em;
		line-height: 1;
		transform: scaleX(0.78);
		transform-origin: center;
		user-select: none;
		width: 100%;
	}

	.archive-card__date-month,
	.archive-card__date-day {
		font-size: 0.95rem;
	}

	.archive-card__date-slash {
		font-size: 0.78rem;
		margin-inline: 0.02em;
		opacity: 0.55;
		position: relative;
		top: 0.02em;
	}

	.archive-card__body {
		display: flex;
		flex: 1;
		flex-direction: column;
		min-width: 0;
	}

	.archive-card__eyebrows {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		column-gap: 0.55em;
		row-gap: 0.15em;
		margin: 0;
	}

	.archive-card__title {
		font-size: 1.15rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.45;
	}

	.archive-card__title--hang {
		margin-left: -0.45em;
	}

	.archive-card__main {
		flex: 1;
		min-width: 0;
	}

	.archive-card__desc {
		color: var(--muted);
		font-size: 0.9rem;
		line-height: 1.7;
		margin: 0.55rem 0 0;
	}

	.archive-card__meta {
		color: var(--muted);
		font-size: 0.8rem;
		letter-spacing: 0.02em;
		margin: auto 0 0;
		padding-top: 0.85rem;
	}

	:root[data-theme='dark'] .archive-card--date .archive-card__plate {
		background: #f5f2f2;
	}

	:root[data-theme='dark'] .archive-card--date .archive-card__date {
		color: #1f1c1d;
	}

	/* 横長ストリップ（バックナンバー一覧） */
	.archive-card--strip-issue {
		--issue-squeeze: 0.68;
		--issue-intro-width: 20rem;
		--issue-feature-width: 18.5rem;
		--issue-gap-intro-feature: 2rem;
		--issue-gap-feature-guest: 2.5rem;
	}

	.archive-card--strip {
		gap: 1rem;
		min-height: 0;
		padding-block: 0.35rem;
	}

	.archive-card--strip .archive-card__mark {
		width: 2.75rem;
	}

	.archive-card--strip .archive-card__num-glyph {
		font-size: 0.88rem;
	}

	.archive-card--strip .archive-card__date-month,
	.archive-card--strip .archive-card__date-day {
		font-size: 0.88rem;
	}

	.archive-card--strip .archive-card__date-slash {
		font-size: 0.72rem;
	}

	.archive-card--strip .archive-card__body {
		align-items: center;
		flex-direction: row;
		flex-wrap: nowrap;
		gap: 0.75rem 1.25rem;
		min-width: 0;
	}

	.archive-card--strip .archive-card__main {
		align-items: center;
		display: flex;
		flex: 1;
		flex-wrap: nowrap;
		gap: 0.75rem 1rem;
		min-width: 0;
	}

	.archive-card--strip .archive-card__title {
		flex-shrink: 0;
		font-size: 1.05rem;
		line-height: 1.2;
		white-space: nowrap;
	}

	.archive-card--strip .archive-card__highlights {
		flex: 1;
		font-family: "Noto Serif JP", "Hiragino Mincho ProN", "Yu Mincho", serif;
		font-size: 1.1rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.25;
		min-width: 0;
		overflow: visible;
	}

	.archive-card--strip .archive-card__highlights-squeeze {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		width: 100%;
	}

	.archive-card--strip .archive-card__highlights-grid {
		color: inherit;
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
		column-gap: 1.25rem;
		min-width: 0;
		text-decoration: none;
		width: 100%;
	}

	.archive-card--strip .archive-card__highlights-grid:hover {
		color: var(--ink);
	}

	.archive-card--strip .archive-card__highlights-grid--issue {
		align-items: baseline;
		display: grid;
		gap: 0;
		grid-template-columns:
			var(--issue-intro-width)
			var(--issue-gap-intro-feature)
			var(--issue-feature-width)
			var(--issue-gap-feature-guest)
			auto;
		transform: scaleX(var(--issue-squeeze));
		transform-origin: left center;
		white-space: nowrap;
		width: calc(100% / var(--issue-squeeze));
	}

	.archive-card--strip .archive-card__highlight-col--intro {
		font-family: inherit;
		font-weight: 400;
		grid-column: 1;
	}

	.archive-card--strip .archive-card__highlight-col--feature {
		grid-column: 3;
	}

	.archive-card--strip .archive-card__highlight-col--guest {
		grid-column: 5;
	}

	.archive-card--strip .archive-card__intro-text {
		color: var(--muted);
		display: inline-block;
		font-family: inherit;
		font-size: 1.02rem;
		font-weight: 400;
		letter-spacing: -0.03em;
		line-height: 1.25;
		white-space: nowrap;
	}

	.archive-card--strip .archive-card__highlight-col {
		align-items: baseline;
		display: block;
		min-width: 0;
		overflow: visible;
		white-space: nowrap;
	}

	.archive-card--strip .archive-card__highlight-col--feature,
	.archive-card--strip .archive-card__highlight-col--guest {
		letter-spacing: -0.03em;
	}

	.archive-card--strip .archive-card__highlight-col--guest .archive-card__highlight-label {
		font-size: 0.76rem;
		letter-spacing: 0.02em;
	}

	.archive-card--strip .archive-card__highlight-label {
		color: var(--muted);
		font-size: 0.84rem;
		font-weight: 600;
		letter-spacing: 0.04em;
	}

	.archive-card--strip .archive-card__highlight-label::after {
		content: '\3000';
	}

	.archive-card--strip .archive-card__highlight-text {
		display: inline;
		font-weight: 900;
	}

	.archive-card--strip .archive-card__desc-link {
		color: inherit;
		text-decoration: none;
	}

	.archive-card--strip .archive-card__desc-link:hover {
		color: var(--ink);
	}

	.archive-card--strip .archive-card__desc {
		flex: 1;
		font-size: 0.85rem;
		line-height: 1.2;
		margin: 0;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.archive-card--strip .archive-card__meta {
		flex-shrink: 0;
		line-height: 1.2;
		margin: 0;
		margin-left: auto;
		padding-top: 0;
		white-space: nowrap;
	}

	@media (max-width: 767px) {
		.archive-card--strip-issue {
			--issue-squeeze: 0.52;
			--issue-intro-width: 16.5rem;
			--issue-feature-width: 15.5rem;
			--issue-gap-intro-feature: 1.35rem;
			--issue-gap-feature-guest: 2rem;
		}
	}

	@media (min-width: 768px) {
		.archive-card {
			gap: 1.1rem;
			padding-block: 2rem;
		}

		.archive-card__mark {
			width: 3.25rem;
		}

		.archive-card__num-glyph {
			font-size: 1.05rem;
		}

		.archive-card__date-month,
		.archive-card__date-day {
			font-size: 1.05rem;
		}

		.archive-card__date-slash {
			font-size: 0.85rem;
		}

		.archive-card__title {
			font-size: 1.2rem;
		}

		.archive-card--strip {
			gap: 1.25rem;
			padding-block: 0.4rem;
		}

		.archive-card--strip .archive-card__mark {
			width: 3rem;
		}

		.archive-card--strip .archive-card__num-glyph {
			font-size: 0.95rem;
		}

		.archive-card--strip .archive-card__date-month,
		.archive-card--strip .archive-card__date-day {
			font-size: 0.95rem;
		}

		.archive-card--strip .archive-card__date-slash {
			font-size: 0.78rem;
		}

		.archive-card--strip .archive-card__title {
			font-size: 1.1rem;
		}

		.archive-card--strip .archive-card__highlights {
			font-size: 1.18rem;
		}

		.archive-card--strip .archive-card__highlight-label {
			font-size: 0.88rem;
		}

		.archive-card--strip .archive-card__intro-text {
			font-size: 1.06rem;
		}

		.archive-card--strip .archive-card__highlight-col--guest .archive-card__highlight-label {
			font-size: 0.8rem;
		}

		.archive-card--strip-issue {
			--issue-intro-width: 21rem;
			--issue-feature-width: 20rem;
			--issue-gap-intro-feature: 2.5rem;
			--issue-gap-feature-guest: 3rem;
		}
	}
</style>

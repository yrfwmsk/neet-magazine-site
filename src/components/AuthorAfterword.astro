---
import { emdashHtml } from '../lib/emdash';

interface Props {
	penName: string;
	afterword: string;
	avatar?: string;
	links?: {
		x?: string;
		note?: string;
		instagram?: string;
		youtube?: string;
		website?: string;
		amazon?: string;
	};
}

const { penName, afterword, avatar, links = {} } = Astro.props;
const socials = [
	{ key: 'note', href: links.note, label: 'note' },
	{ key: 'x', href: links.x, label: 'X' },
	{ key: 'instagram', href: links.instagram, label: 'Instagram' },
	{ key: 'youtube', href: links.youtube, label: 'YouTube' },
	{ key: 'amazon', href: links.amazon, label: 'Amazon' },
	{ key: 'website', href: links.website, label: '個人ホームページ' },
].filter((item) => Boolean(item.href));
---

<aside class="author-afterword" aria-label="著者あとがき">
	{avatar ? (
		<img class="author-afterword__avatar" src={avatar} alt="" width="96" height="96" />
	) : (
		<span class="author-afterword__avatar author-afterword__avatar--empty" aria-hidden="true"></span>
	)}
	<div class="author-afterword__body">
		<p class="author-afterword__name">{penName}</p>
		<p class="author-afterword__text" set:html={emdashHtml(afterword)} />
		{socials.length > 0 && (
			<ul class="author-afterword__links">
				{socials.map((item) => (
					<li>
						<a href={item.href} target="_blank" rel="noopener noreferrer" aria-label={item.label}>
							{item.key === 'x' && (
								<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
									<path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.727-8.835L1.254 2.25H8.08l4.253 5.622L18.244 2.25Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z" />
								</svg>
							)}
							{item.key === 'note' && (
								<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
									<path fill="currentColor" d="M5 4h10.2c2.7 0 4.8 2.1 4.8 4.8v6.4c0 2.7-2.1 4.8-4.8 4.8H5V4Zm2.2 2.2v11.4h8c1.5 0 2.6-1.1 2.6-2.6V8.8c0-1.5-1.1-2.6-2.6-2.6H7.2Zm1.8 2.3h6.2v1.6H9V8.5Zm0 3.2h6.2v1.6H9v-1.6Zm0 3.2h4.2v1.6H9v-1.6Z" />
								</svg>
							)}
							{item.key === 'instagram' && (
								<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
									<path fill="currentColor" d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2Zm-.2 2A3.6 3.6 0 0 0 4 7.6v8.8A3.6 3.6 0 0 0 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6A3.6 3.6 0 0 0 16.4 4H7.6Zm9.65 1.5a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z" />
								</svg>
							)}
							{item.key === 'youtube' && (
								<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
									<path fill="currentColor" d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
								</svg>
							)}
							{item.key === 'website' && (
								<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
									<path fill="currentColor" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm7.9 9h-3.2a15 15 0 0 0-1.3-5.2A8 8 0 0 1 19.9 11ZM12 4c.9 0 2.3 1.8 3 5H9c.7-3.2 2.1-5 3-5ZM4.1 13h3.2c.2 1.9.7 3.7 1.3 5.2A8 8 0 0 1 4.1 13Zm3.2-2H4.1a8 8 0 0 1 4.5-5.2A15 15 0 0 0 7.3 11Zm1.7 2h6c-.7 3.2-2.1 5-3 5s-2.3-1.8-3-5Zm6-2h-6c.7-3.2 2.1-5 3-5s2.3 1.8 3 5Zm.7 7.2c.6-1.5 1.1-3.3 1.3-5.2h3.2a8 8 0 0 1-4.5 5.2Z" />
								</svg>
							)}
							{item.key === 'amazon' && (
								<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
									<path fill="currentColor" d="M.045 18.02c.072-.116.187-.124.348-.022 3.636 2.11 7.594 3.166 11.87 3.166 2.852 0 5.668-.533 8.447-1.595l.315-.14c.138-.06.234-.1.293-.13.226-.088.39-.046.525.13.12.174.09.336-.12.48-.256.19-.6.41-1.006.654-1.244.743-2.64 1.316-4.185 1.726a17.617 17.617 0 01-10.951-.577 17.88 17.88 0 01-5.43-3.35c-.1-.074-.151-.15-.151-.22 0-.047.021-.09.051-.13zm6.565-6.218c0-1.005.247-1.863.743-2.577.495-.71 1.17-1.25 2.04-1.615.796-.335 1.756-.575 2.912-.72.39-.046 1.033-.103 1.92-.174v-.37c0-.93-.105-1.558-.3-1.875-.302-.43-.78-.65-1.44-.65h-.182c-.48.046-.896.196-1.246.46-.35.27-.575.63-.675 1.096-.06.3-.206.465-.435.51l-2.52-.315c-.248-.06-.372-.18-.372-.39 0-.046.007-.09.022-.15.247-1.29.855-2.25 1.82-2.88.976-.616 2.1-.975 3.39-1.05h.54c1.65 0 2.957.434 3.888 1.29.135.15.27.3.405.48.12.165.224.314.283.45.075.134.15.33.195.57.06.254.105.42.135.51.03.104.062.3.076.615.01.313.02.493.02.553v5.28c0 .376.06.72.165 1.036.105.313.21.54.315.674l.51.674c.09.136.136.256.136.36 0 .12-.06.226-.18.314-1.2 1.05-1.86 1.62-1.963 1.71-.165.135-.375.15-.63.045a6.062 6.062 0 01-.526-.496l-.31-.347a9.391 9.391 0 01-.317-.42l-.3-.435c-.81.886-1.603 1.44-2.4 1.665-.494.15-1.093.227-1.83.227-1.11 0-2.04-.343-2.76-1.034-.72-.69-1.08-1.665-1.08-2.94l-.05-.076zm3.753-.438c0 .566.14 1.02.425 1.364.285.34.675.512 1.155.512.045 0 .106-.007.195-.02.09-.016.134-.023.166-.023.614-.16 1.08-.553 1.424-1.178.165-.28.285-.58.36-.91.09-.32.12-.59.135-.8.015-.195.015-.54.015-1.005v-.54c-.84 0-1.484.06-1.92.18-1.275.36-1.92 1.17-1.92 2.43l-.035-.02zm9.162 7.027c.03-.06.075-.11.132-.17.362-.243.714-.41 1.05-.5a8.094 8.094 0 011.612-.24c.14-.012.28 0 .41.03.65.06 1.05.168 1.172.33.063.09.099.228.099.39v.15c0 .51-.149 1.11-.424 1.8-.278.69-.664 1.248-1.156 1.68-.073.06-.14.09-.197.09-.03 0-.06 0-.09-.012-.09-.044-.107-.12-.064-.24.54-1.26.806-2.143.806-2.64 0-.15-.03-.27-.087-.344-.145-.166-.55-.257-1.224-.257-.243 0-.533.016-.87.046-.363.045-.7.09-1 .135-.09 0-.148-.014-.18-.044-.03-.03-.036-.047-.02-.077 0-.017.006-.03.02-.063v-.06z" />
								</svg>
							)}
						</a>
					</li>
				))}
			</ul>
		)}
	</div>
</aside>

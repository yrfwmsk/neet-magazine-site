---
import { LAYOUT_TESTS, type LayoutTestId } from '../lib/article-layout-test';

interface Props {
	current: LayoutTestId;
}

const { current } = Astro.props;
---

<nav class="article-layout-test-nav" aria-label="記事レイアウト案の切り替え">
	<a href="/magazines/article-layout-tests">一覧</a>
	{LAYOUT_TESTS.map((test) => (
		<a href={test.href} aria-current={test.id === current ? 'page' : undefined}>{test.label}</a>
	))}
	<a href="/magazines/vol2/ten-years">本番記事</a>
</nav>

<style>
	.article-layout-test-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem 1rem;
		font-size: 0.8rem;
		letter-spacing: 0.04em;
		margin-top: 1.5rem;
	}

	.article-layout-test-nav a {
		color: var(--muted);
		text-decoration: none;
	}

	.article-layout-test-nav a[aria-current='page'] {
		color: var(--ink);
		font-weight: 700;
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.article-layout-test-nav a:hover {
		color: var(--ink);
		opacity: 1;
	}
</style>
